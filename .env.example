# Vercel env vars for /api/partner-intake. Copy to Vercel project → Settings → Environment Variables.
# Never commit a real .env file.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_PARTNER_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Comma-separated. Defaults are nick@ + partners@ if unset.
NOTIFY_TO=nick@downtownpourcollective.com,partners@downtownpourcollective.com

# Must be a verified sender on the Resend domain.
NOTIFY_FROM=DPC Partners <partners@downtownpourcollective.com>

# Auto-acknowledgment email (per DPC_Partner_Intake_Email_Spec_v1_0).
# Defaults below are the spec-locked production values. Override only for
# local dev (e.g. AUTOACK_FROM=Downtown Pour Collective <onboarding@resend.dev>
# while the domain is being verified).
AUTOACK_FROM=Downtown Pour Collective <partners@downtownpourcollective.com>
AUTOACK_REPLY_TO=nick@downtownpourcollective.com
