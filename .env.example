# Vercel env vars. Copy to Vercel project → Settings → Environment Variables.
# Never commit a real .env file.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Partner intake (/api/partner-intake)
RESEND_PARTNER_AUDIENCE_ID=00000000-0000-0000-0000-000000000000
NOTIFY_TO=nick@downtownpourcollective.com,partners@downtownpourcollective.com
NOTIFY_FROM=DPC Partners <partners@downtownpourcollective.com>
AUTOACK_FROM=Downtown Pour Collective <partners@downtownpourcollective.com>
AUTOACK_REPLY_TO=nick@downtownpourcollective.com

# Founding deposit welcome email (/api/stripe-webhook)
RESEND_FOUNDING_AUDIENCE_ID=00000000-0000-0000-0000-000000000000
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
WELCOME_FROM=Downtown Pour Collective <hello@downtownpourcollective.com>
WELCOME_REPLY_TO=hello@downtownpourcollective.com
WELCOME_SUBJECT=Your Founding Spot is reserved
NOTIFY_DEPOSIT_TO=nick@downtownpourcollective.com,hello@downtownpourcollective.com
NOTIFY_DEPOSIT_FROM=Downtown Pour Collective <hello@downtownpourcollective.com>

# Verified welcome Purchase deduplication (/api/welcome-checkout).
# Dedicated server-only secret: generate at least 32 random bytes, keep stable
# across deployments, and use separate production/preview values. Required.
WELCOME_EVENT_ID_SECRET=

# Production operations alerts (/api/health-check). All three are required for
# a green check. Only ALERT_TO blocks delivery; sender and reply-to defects use
# safe fallbacks. These never inherit business-notification identities.
ALERT_TO=ops-recipient@example.com
ALERT_FROM=DPC Operations <support@downtownpourcollective.com>
ALERT_REPLY_TO=ops-reply@example.com

# Production-only Sentry Relay Cron ingestion URL. Copy the complete URL shown
# by Sentry; do not use a legacy /api/0/.../monitors endpoint.
SENTRY_CRON_CHECKIN_URL=https://YOUR_SENTRY_RELAY_CRON_URL

# Support dashboard (/admin/support, served by /api/admin-config).
# Falls back to SUPABASE_URL / SUPABASE_ANON_KEY when unset. This value is sent
# to the browser, so it must be the anon (publishable) key — never service_role.
ADMIN_SUPABASE_URL=https://your-project-ref.supabase.co
ADMIN_SUPABASE_ANON_KEY=your_supabase_anon_key

# Signed-link Pour reminder page. Unset/false stays unavailable and makes no
# membership API calls. Configure separately per Vercel environment only after
# approval; never fall back to the generic SUPABASE_URL or any credential.
POUR_REMINDER_PAGE_ENABLED=false
POUR_REMINDER_API_URL=
# Preview: https://hohbsqkmrlhkstojfdgx.supabase.co/functions/v1/pour-reminder-preferences
# Production: https://ebiuspbgzggrdiaswpcc.supabase.co/functions/v1/pour-reminder-preferences
